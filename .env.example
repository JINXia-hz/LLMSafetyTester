# ============================================================
# LLMSEC 配置模板 —— 复制本文件为 .env 后按说明填写
#   cp .env.example .env
# 带 ✱ 的为必填；整行被注释的为可选项（按需取消注释）
# ============================================================

# ===== ✱ 目标模型（被测对象） =====
TARGET_TYPE=openai                     # openai / local_sim / pcap_judge
TARGET_API_KEY=sk-yyy
TARGET_BASE_URL=https://api.deepseek.com/v1
TARGET_MODEL=deepseek-v4-flash

# ===== 可选：多目标并行评估（runner --targets bob,alice） =====
# TARGETS=逗号分隔的目标名；每个目标用 TARGET_<N>_ 四件套声明（编号是稳定
# 标识符，允许有缺口；TARGET_<N>_NAME 必填，TYPE/API_KEY/BASE_URL/MODEL
# 缺失则回退上方全局值）。也可用名字前缀代替编号：TARGET_<小写名>_BASE_URL
# 或 TARGET_<小写名>_API_KEY（至少一项即被识别）。
# TARGETS=bob,alice
# TARGET_1_NAME=bob
# TARGET_1_MODEL=qwen3.5-72b
# TARGET_1_BASE_URL=http://host-a:8000/v1
# TARGET_1_API_KEY=sk-aaa
# TARGET_2_NAME=alice
# TARGET_2_TYPE=pcap_judge            # 每目标可覆盖后端类型
# TARGET_2_BASE_URL=http://host-b:9000/v1
# TARGET_2_API_KEY=sk-bbb

# ===== ✱ 生成模型（攻击生成 / 安全孪生 / 报告叙事） =====
GENERATOR_API_KEY=sk-xxx
GENERATOR_BASE_URL=https://api.deepseek.com/v1
GENERATOR_MODEL=deepseek-v4-flash
JUDGE_MODEL=deepseek-v4-flash          # Judge 模型；缺省时回退 GENERATOR_MODEL
# JUDGE_BASE_URL=https://api.deepseek.com/v1  # Judge 独立端点（judge 换服务商时设）；缺省回退 GENERATOR_BASE_URL
# JUDGE_API_KEY=sk-jjj                # Judge 独立凭证（优先于 GENERATOR_API_KEY）；缺省回退 GENERATOR_API_KEY
# SAFE_TWIN_MODEL=deepseek-v4-flash   # 安全孪生生成模型（Phase 2 误杀检测；缺省回退默认）
# 超时 / token 预算（推理模型如 minimax 需更大值；不设则用代码默认）：
# GENERATOR_TIMEOUT=60         # 生成模型单次请求超时（秒）
# JUDGE_TIMEOUT=90             # Judge 单次请求超时（秒）
# REPORT_TIMEOUT=180           # 叙事报告超时（长任务，默认远大于 GENERATOR）
# JUDGE_MAX_TOKENS=1024        # Judge 最大输出 token（推理模型建议 ≥1024）
# GENERATOR_MAX_TOKENS=4096    # 生成模型最大输出 token

# ===== 推荐：语义 embedding（hf-mirror 镜像 + 项目内缓存） =====
# huggingface.co 不可达（如企业内网）时走镜像；模型下载一次后离线可用
HF_ENDPOINT=https://hf-mirror.com
SENTENCE_TRANSFORMERS_HOME=llmsec/.models
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ===== 可选：PCAP Judge 模式（TARGET_TYPE=pcap_judge 时必填） =====
# PCAP_JUDGE_URL=https://your-pcap-judge/api/v1/soc/pcap/judge
# PCAP_MODEL_VERSION=v2.3            # 判读模型版本（pcap 模式的防御方名 = 此值）
# PCAP_PROMPT_KEY=default            # judge 的 prompt key
# PCAP_VERIFY_TLS=0                  # TLS 证书校验（默认 0——内网自签名证书；公网部署置 1）

# ===== 可选：API embedding（OpenAI 兼容 /embeddings，三项齐全时优先于本地缓存） =====
# 内网部署的 bge-m3：填入 KEY 即生效；留空则自动回落本地缓存的 EMBEDDING_MODEL
EMBEDDING_API_BASE=http://your-embedding-host:port/v1
EMBEDDING_API_KEY=
EMBEDDING_API_MODEL=bge-m3

# ===== 可选：local_sim 离线模拟目标（TARGET_TYPE=local_sim） =====
# LOCAL_SIM_SEED=42                   # 模拟器随机种子（固定值保证复现）

# ===== 可选：三省 Agent（control 层）独立凭证 =====
# 逐项回退 GENERATOR_*；三者都可留空（Agent 无独立模型时共用生成模型）
# CONTROL_API_KEY=
# CONTROL_BASE_URL=
# CONTROL_MODEL=

# ===== 可选：行为参数覆盖（llmsec/params.py 的全部常量） =====
# 任意 params.py 常量都可用 LLMSEC_PARAM_<常量名> 覆盖（bool/int/float/str
# 按原值类型自动转换；拼写错误仅告警不生效）。完整清单见 llmsec/params.py：
# LLMSEC_PARAM_DEFAULT_SAMPLER=infogain
# LLMSEC_PARAM_CONV_CI_TARGET=15

# ===== 可选：监控告警（任务失败/HPO 熔断/僵尸任务时主动通知） =====
# 日志级别（DEBUG/INFO/WARNING/ERROR，默认 INFO）
# LLMSEC_LOG_LEVEL=INFO
# 日志落盘路径（默认 output/logs/llmsec.log，10MB 轮转保留 5 份）；
# 置空字符串则不落盘（仅 stdout，CLI 短任务可关）
# LLMSEC_LOG_FILE=output/logs/llmsec.log
# 告警 webhook URL（飞书/钉钉/企业微信/Slack 入站 webhook 均可，POST JSON）；
# 留空则不启用 webhook（告警仍写入 output/alerts.jsonl）
# LLMSEC_ALERT_WEBHOOK=
# 最低告警级别（info/warning/error，默认 warning——只发 warning 及以上）
# LLMSEC_ALERT_LEVEL=warning
# 僵尸任务检测：任务 running 超该分钟数无产出则告警（默认 60；告警但不自动杀）
# LLMSEC_ZOMBIE_MINUTES=60

# ===== 运行期注入键（无需手填） =====
# LLMSEC_TASK_ID=（由看板 task_manager 注入评估子进程，用于 progress.jsonl
# 进度流关联；手动 CLI 运行不涉及）
