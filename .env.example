# ============================================================
# LLMSEC 配置模板 —— 复制本文件为 .env 后按说明填写
#   cp .env.example .env
# 带 ✱ 的为必填；整行被注释的为可选项（按需取消注释）
# ============================================================

# ===== ✱ 目标模型（被测对象） =====
TARGET_TYPE=openai                     # openai / local_sim / pcap_judge
TARGET_API_KEY=sk-yyy
TARGET_BASE_URL=https://api.deepseek.com/v1
TARGET_MODEL=deepseek-v4-flash

# ===== ✱ 生成模型（攻击生成 / 安全孪生 / 报告叙事） =====
GENERATOR_API_KEY=sk-xxx
GENERATOR_BASE_URL=https://api.deepseek.com/v1
GENERATOR_MODEL=deepseek-v4-flash
JUDGE_MODEL=deepseek-v4-flash          # Judge 模型；缺省时回退 GENERATOR
# 超时 / token 预算（推理模型如 minimax 需更大值；不设则用代码默认）：
# GENERATOR_TIMEOUT=60         # 生成模型单次请求超时（秒）
# JUDGE_TIMEOUT=90             # Judge 单次请求超时（秒）
# REPORT_TIMEOUT=180           # 叙事报告超时（长任务，默认远大于 GENERATOR）
# JUDGE_MAX_TOKENS=1024        # Judge 最大输出 token（推理模型建议 ≥1024）
# GENERATOR_MAX_TOKENS=4096    # 生成模型最大输出 token

# ===== 推荐：语义 embedding（hf-mirror 镜像 + 项目内缓存） =====
# huggingface.co 不可达（如企业内网）时走镜像；模型下载一次后离线可用
HF_ENDPOINT=https://hf-mirror.com
SENTENCE_TRANSFORMERS_HOME=llmsec/.models
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ===== 可选：PCAP Judge 模式（TARGET_TYPE=pcap_judge 时必填） =====
# PCAP_JUDGE_URL=https://your-pcap-judge/api/v1/soc/pcap/judge

# ===== 可选：API embedding（OpenAI 兼容 /embeddings，三项齐全时优先于本地缓存） =====
# 内网部署的 bge-m3：填入 KEY 即生效；留空则自动回落本地缓存的 EMBEDDING_MODEL
EMBEDDING_API_BASE=http://your-embedding-host:port/v1
EMBEDDING_API_KEY=
EMBEDDING_API_MODEL=bge-m3
