# 环境变量（含API密钥）
.env
.env.bak
.env.tmp
.venv/
# embedding 模型缓存（体积大，首次经镜像下载后离线可用）
llmsec/.models/
# Python
__pycache__/
*.py[cod]/
*.egg-info/
# 打包/测试产物（python -m build / pytest --cov 的本地输出）
dist/
build/
.coverage
.zcode/
# 生成产物（state/runs/tasks/聚类缓存等）
output/

# 攻击集（仅保留示例文件，其余由用户自行生成或上传）
attacks/*
!attacks/example.jsonl

# IDE
.vscode/
.idea/
# 本地维护脚本（不入库：HPO 编排等仓库侧工具）
# 例外：测试清单生成器——CI 的 --check 依赖它，新克隆必须可复现
scripts/*
!scripts/gen_test_inventory.py
/experiments/
video/